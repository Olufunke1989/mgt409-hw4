# Copy this file to .env (in this hw4 folder) and fill in your own values.
# Never commit the real .env file.

# Which AI provider to use: "openai" (direct) or "portkey"
AI_PROVIDER=openai

# Which model the chatbot uses
OPENAI_MODEL=gpt-6-luna

# Your OpenAI API key (required when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Your Portkey API key (only needed when AI_PROVIDER=portkey)
PORTKEY_API_KEY=

# Optional: any long random string. Keeps customers logged in across backend restarts.
SESSION_SECRET=

# Optional: seconds the chatbot may spend on one answer (default 45)
CHAT_TIMEOUT_SECONDS=
